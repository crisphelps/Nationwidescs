{
  "version": 2,
  "builds": [
    {
      "src": "resource-deliverables-app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "resource-deliverables-app.js"
    }
  ],
  "env": {
    "SLACK_BOT_TOKEN": "@slack_bot_token",
    "SLACK_SIGNING_SECRET": "@slack_signing_secret",
    "ANTHROPIC_API_KEY": "@anthropic_api_key"
  }
}
